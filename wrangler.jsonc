{
  "name": "casa-plataforma",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "casa-videos"
    }
  ],
  // Correos transaccionales (Cloudflare Email Service). El dominio debe estar habilitado en Email Sending.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casa-test-bienestar-db",
      "database_id": "720d3530-922f-4214-9e9b-3f09aaf109a9"
    }
  ]
}
